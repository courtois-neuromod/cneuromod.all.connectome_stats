*.tsv
*.h5

# Guard: CNeuroMod content is neuroimaging data under a data-use agreement, and
# some of it is not openly licensed. No fetch step writes a volume directly
# here, but keep these so a stray image can never be committed by accident.
*.nii
*.nii.gz

# The fetched superdataset (normally a symlink to a local checkout).
cneuromod.all

# Which files this machine could not retrieve, so fetch-timeseries does not
# retry them. Per-environment (it records *your* access), never shared.
.fetch_failures.json

# Provenance is tracked: it records what the inputs actually were.
!MANIFEST.json
